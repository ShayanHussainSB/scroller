{
  "manifest_version": 3,
  "name": "Scroller",
  "version": "1.3.0",
  "description": "Hands-free auto-scroll for manga, webtoons and novels. One key to start, any speed, words per minute, night mode.",
  "homepage_url": "https://github.com/ShayanHussainSB/scroller",
  "permissions": ["storage"],
  "background": { "service_worker": "scripts/background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scroller",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/defaults.js", "scripts/content.js", "scripts/night.js", "scripts/pages.js", "scripts/wpm.js", "scripts/session.js"],
      "all_frames": true
    }
  ]
}
